<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>dotnet-Informer-07055837-193b-4a90-9010-b459a644b0f0</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.13"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ExtremistDetector.Contracts\ExtremistDetector.Contracts.csproj" />
      <ProjectReference Include="..\ExtremistDetector.Infrastructure\ExtremistDetector.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Samples\Processed\" />
      <Folder Include="Services\" />
    </ItemGroup>

    <ItemGroup>
      <None Update="Samples\SomeSite.html">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="Samples\SocialSitePost.txt">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="Samples\Logs.log">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Content Update="Samples\Messages.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
</Project>
